<Window x:Class="FocusApp.BlockedToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App blocked" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Foreground="{DynamicResource Text}" FontFamily="{StaticResource BodyFont}">
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Panel3}" BorderThickness="1"
            CornerRadius="10" Padding="18,14" Margin="4" Width="320">
        <DockPanel>
            <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{DynamicResource FocusBrush}"
                    Margin="0,2,14,2"/>
            <Button x:Name="ActionBtn" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" FontWeight="SemiBold"
                    VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed" Click="ActionBtn_Click"/>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DetailText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
