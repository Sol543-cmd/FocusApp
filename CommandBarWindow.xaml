<Window x:Class="FocusApp.CommandBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command bar" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height" Width="620"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource Text}" FontFamily="{StaticResource BodyFont}">
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="12" Padding="8" Margin="10">
        <StackPanel>
            <Grid>
                <TextBox x:Name="Input" FontSize="17" BorderThickness="0" Background="Transparent" Padding="10,10"
                         TextChanged="Input_TextChanged" PreviewKeyDown="Input_PreviewKeyDown"/>
                <TextBlock x:Name="Hint" Text="Type a command or search tasks..." FontSize="17" Margin="13,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Muted}"/>
            </Grid>
            <Border Height="1" Background="{DynamicResource Line}" Margin="0,4,0,6"/>
            <ItemsControl x:Name="Results" MaxHeight="420">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" CornerRadius="6" Padding="12,8" Background="Transparent" Cursor="Hand"
                                MouseLeftButtonUp="Row_Click">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" FontSize="12" Foreground="{DynamicResource Muted}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource NavSelected}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="↑ ↓ to choose, Enter to run, Esc to close. Start with + to add a task." FontSize="11"
                       Foreground="{DynamicResource Muted}" Margin="12,6,0,2"/>
        </StackPanel>
    </Border>
</Window>
