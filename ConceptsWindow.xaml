<Window x:Class="FocusApp.ConceptsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Concepts" Width="780" Height="760" MinWidth="560" MinHeight="500" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource BodyFont}">
    <Border Margin="16" Padding="24,20" CornerRadius="12" Background="{DynamicResource Panel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Concepts" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Questions and answers from your reading. In practice you match each question to its answer."/>
                <Grid Margin="0,0,0,6">
                    <TextBox x:Name="SearchBox" FontSize="14" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="Search questions, answers or chapters" Style="{StaticResource Caption}"
                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <DockPanel Margin="2,0,0,10">
                    <Button x:Name="RemoveSelectedBtn" DockPanel.Dock="Right" Content="Remove selected" Click="RemoveSelected_Click" Visibility="Collapsed" Padding="12,4"/>
                    <TextBlock x:Name="CountText" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
            <!-- Add (or edit) a card, or paste a list -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel2}" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="PasteToggle" DockPanel.Dock="Right" Content="Paste a list" Style="{StaticResource LinkButton}" Click="PasteToggle_Click"/>
                        <TextBlock x:Name="EditTitle" Text="Add a question" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel x:Name="SingleEntry">
                        <TextBlock Text="Question" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <TextBox x:Name="QuestionBox" FontSize="14" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="110" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="Answer" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
                        <TextBox x:Name="AnswerBox" FontSize="14" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="32" MaxHeight="90" VerticalScrollBarVisibility="Auto"/>
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button x:Name="CancelEditBtn" Content="Cancel" Click="CancelEdit_Click" Margin="0,0,6,0" Visibility="Collapsed"/>
                                <Button x:Name="SaveBtn" Content="Add" Style="{StaticResource PrimaryButton}" Click="Save_Click" Padding="18,7"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Chapter or reading (optional)" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ChapterBox" FontSize="13"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel x:Name="PasteEntry" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="One per line: the question, then = (or a tab), then the answer. For example: What is a deponent verb? = A verb with middle or passive forms but an active meaning"/>
                        <TextBox x:Name="PasteBox" FontSize="13" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" Height="150"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Add them" Style="{StaticResource PrimaryButton}" Click="PasteAdd_Click" Padding="18,7"/>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Chapter or reading for all of them (optional)" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                <TextBox x:Name="PasteChapterBox" FontSize="13"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock x:Name="NoteText" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Results"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
