<Window x:Class="FocusApp.FlashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Opacity="0" Cursor="Hand" Width="400" Height="300"
        Foreground="{DynamicResource Text}" FontFamily="{StaticResource BodyFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <!-- Soft dimmed backdrop over the whole screen -->
        <Rectangle Fill="{DynamicResource Shade}"/>
        <!-- The card: clean, rounded, with a gentle shadow, in the app's colors -->
        <Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520"
                Background="{DynamicResource Panel}" CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="0.96" ScaleY="0.96"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.22" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="40,32,40,26">
                    <!-- Brand -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                        <Image Source="logo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="FOCUS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <!-- Icon, headline and what's next -->
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="56" Height="56" VerticalAlignment="Top">
                            <Ellipse x:Name="IconBack" Fill="{DynamicResource FocusTint}"/>
                            <TextBlock x:Name="IconGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FocusBrush}"/>
                        </Grid>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center" MaxWidth="380">
                            <TextBlock x:Name="HeadText" FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource HeadingFont}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="SubText" FontSize="15" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Time chip -->
                    <Border x:Name="TimeChip" HorizontalAlignment="Left" CornerRadius="14" Padding="14,6" Margin="74,16,0,0"
                            Background="{DynamicResource Panel2}">
                        <TextBlock x:Name="TimeText" FontSize="14" FontWeight="SemiBold"/>
                    </Border>
                    <!-- This session's first few tasks -->
                    <StackPanel x:Name="TaskPanel" Margin="74,16,0,0" Visibility="Collapsed"/>
                    <TextBlock Text="Click anywhere to dismiss" Style="{StaticResource Caption}" FontSize="11.5"
                               HorizontalAlignment="Right" Margin="0,22,0,0"/>
                </StackPanel>
                <!-- Thin bar that runs down until the card closes by itself -->
                <Border Grid.Row="1" Height="4" CornerRadius="0,0,20,20" ClipToBounds="True" Background="{DynamicResource Panel2}">
                    <Border x:Name="CountdownBar" HorizontalAlignment="Left" Background="{DynamicResource FocusBrush}" Width="518"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
