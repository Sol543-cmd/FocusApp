<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FocusApp</AssemblyName>
    <RootNamespace>FocusApp</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.7.1</Version>
    <Product>Focus</Product>
  </PropertyGroup>

  <!-- "dotnet publish -c Release" makes one standalone FocusApp.exe that runs on any 64-bit Windows PC. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="logo.png" />
    <Resource Include="Fonts\FocusCormorant-SemiBold.ttf" />
    <EmbeddedResource Include="GreekWords.tsv" LogicalName="FocusApp.GreekWords.tsv" />
  </ItemGroup>

  <!-- Where updates come from. The GitHub build fills this in (owner/repo); local builds leave it empty and never check. -->
  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
  </ItemGroup>

</Project>
