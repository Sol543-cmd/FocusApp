cResource NavButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,2" Checked="SettingsNav_Checked"/><RadioButton Content="Tasks" Tag="tasks" GroupName="settingsnav" Style="{StaticResource NavButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,2" Checked="SettingsNav_Checked"/><RadioButton Content="Calendar" Tag="calendar" GroupName="settingsnav" Style="{StaticResource NavButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,2" Checked="SettingsNav_Checked"/><RadioButton Content="Greek practice" Tag="greek" GroupName="settingsnav" Style="{StaticResource NavButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,2" Checked="SettingsNav_Checked"/><RadioButton Content="Sync and data" Tag="data" GroupName="settingsnav" Style="{StaticResource NavButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,2" Checked="SettingsNav_Checked"/><RadioButton Content="Features" Tag="features" GroupName="settingsnav" Style="{StaticResource NavButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,2" Checked="SettingsNav_Checked"/><RadioButton Content="Help" Tag="help" GroupName="settingsnav" Style="{StaticResource NavButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,2" Checked="SettingsNav_Checked"/></StackPanel></DockPanel></Border><ScrollViewer x:Name="SettingsScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto"><Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="28" VerticalAlignment="Top"><StackPanel HorizontalAlignment="Left" Width="560"><TextBlock x:Name="SettingsNoResults" Text="No settings match that." Style="{StaticResource Caption}" Visibility="Collapsed"/><StackPanel x:Name="SettingsPage_general" Tag="general"><TextBlock Text="General" Style="{StaticResource Heading}" Margin="0,0,0,6"/><StackPanel Tag="section"><TextBlock Text="Working day" Style="{StaticResource SubHeading}" Margin="0,26,0,4"/><TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap" Text="The usual hours automatic plans fill. Change a single day with Adjust working day in the Day plan."/><StackPanel Orientation="Horizontal">
