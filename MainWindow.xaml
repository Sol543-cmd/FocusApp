<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FocusApp" x:Class="FocusApp.MainWindow" Title="Focus" Height="840" Width="1360" MinHeight="640" WindowStartupLocation="CenterScreen" Icon="app.ico" MinWidth="1080" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource BodyFont}">

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="252"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="22"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- ===== App picker: opens under whichever "block apps" button was clicked ===== -->
        <Popup x:Name="PickerPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade" Closed="PickerPopup_Closed">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="16" Width="370" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Apps to block" Style="{StaticResource SubHeading}"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12" Text="Type to search, then press Enter to add the top match. Keep typing to add more."/>
                    <TextBox x:Name="PickerSearch" TextChanged="PickerSearch_TextChanged" PreviewKeyDown="PickerSearch_PreviewKeyDown"/>
                    <TextBlock x:Name="PickerAddedText" Style="{StaticResource Caption}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    <Grid Height="290" Margin="0,8,0,12">
                        <TextBlock x:Name="PickerStatus" IsHitTestVisible="False" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Finding your apps..."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PickerList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanChange}" Margin="0,0,8,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <DockPanel>
                        <Button Content="Refresh" Click="PickerRefresh_Click" Margin="0,0,8,0"/>
                        <Button Content="Find app file" Click="PickerBrowse_Click" ToolTip="Not in the list? Pick the app's .exe file"/>
                        <Button Content="Done" Style="{StaticResource PrimaryButton}" Padding="20,8" HorizontalAlignment="Right" Click="PickerDone_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ===== Block list picker ===== -->
        <Popup x:Name="ListPickerPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade" Closed="ListPickerPopup_Closed">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="16" Width="320" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Block lists" Style="{StaticResource SubHeading}"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12" Text="Every app in a checked list is blocked during this session."/>
                    <TextBlock x:Name="ListPickerEmpty" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="You haven't made any block lists yet. Make them in the Block lists tab."/>
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListPickerList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanChange}" Margin="0,0,8,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <DockPanel Margin="0,8,0,0">
                        <Button Content="Manage lists" Click="ManageLists_Click"/>
                        <Button Content="Done" Style="{StaticResource PrimaryButton}" Padding="20,8" HorizontalAlignment="Right" Click="ListPickerDone_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ===== Adjust working day ===== -->
        <Popup x:Name="AdjustDayPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="18" Width="320" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Working day" Style="{StaticResource SubHeading}"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,14" Text="Start later or earlier, end sooner or later. Focus sessions and breaks reshape to fill the new hours; meetings and set breaks keep their times."/>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Start" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="AdjustStartBox" Width="110"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="End" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="AdjustEndBox" Width="110"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="AdjustNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Cancel" Click="AdjustCancel_Click" Margin="0,0,8,0"/>
                        <Button Content="Apply" Style="{StaticResource PrimaryButton}" Padding="20,8" Click="AdjustApply_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ===== Task details ===== -->
        <!-- ===== Notifications ===== -->
        <Popup x:Name="NoticePopup" StaysOpen="False" AllowsTransparency="True" Placement="Right" PopupAnimation="Fade">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,14" Width="380" MaxHeight="560" Margin="8,0,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Clear all" Style="{StaticResource LinkButton}" Click="ClearNotices_Click"/>
                        <TextBlock Text="Notifications" Style="{StaticResource SubHeading}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="NoticeEmpty" DockPanel.Dock="Top" Text="You're all caught up." Style="{StaticResource Caption}" Margin="2,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NoticeList"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <Popup x:Name="TaskPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="18" Width="380" Margin="0,6,0,0" PreviewKeyDown="TaskPopup_PreviewKeyDown">
                <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="Task" Style="{StaticResource SubHeading}"/>
                    <TextBox x:Name="TaskTextBox" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="{DynamicResource TaskFontSize}"/>
                    <StackPanel x:Name="TaskProjectRow">
                        <TextBlock Text="Project" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                        <WrapPanel x:Name="TaskProjectPicker"/>
                        <StackPanel x:Name="TaskSectionRow" Visibility="Collapsed">
                            <TextBlock Text="Section" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
                            <WrapPanel x:Name="TaskSectionPicker"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Priority" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TaskPrioHigh" Content="High" GroupName="taskprio" Style="{StaticResource NavButton}"/>
                        <RadioButton x:Name="TaskPrioNormal" Content="Normal" GroupName="taskprio" Style="{StaticResource NavButton}"/>
                        <RadioButton x:Name="TaskPrioLow" Content="Low" GroupName="taskprio" Style="{StaticResource NavButton}"/>
                    </StackPanel>
                    <TextBlock Text="Due date (optional)" Style="{StaticResource Caption}" Margin="0,12,0,4" x:Name="TaskDueLabel"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="TaskDueBox" Width="140" ToolTip="Like 10/14, Friday, or tomorrow. Leave empty for no due date."/>
                        <Button Content="Today" Style="{StaticResource LinkButton}" Click="TaskDueToday_Click" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <Button Content="Tomorrow" Style="{StaticResource LinkButton}" Click="TaskDueTomorrow_Click" VerticalAlignment="Center"/>
                        <Button Content="None" Style="{StaticResource LinkButton}" Click="TaskDueNone_Click" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="How long will it take? (optional, in focus sessions)" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                    <WrapPanel>
                        <RadioButton x:Name="TaskEstNone" Content="Not sure" GroupName="taskest" Style="{StaticResource NavButton}"/>
                        <RadioButton x:Name="TaskEstQuick" Content="Quick" GroupName="taskest" Style="{StaticResource NavButton}"/>
                        <RadioButton x:Name="TaskEst1" Content="1" GroupName="taskest" Style="{StaticResource NavButton}"/>
                        <RadioButton x:Name="TaskEst2" Content="2" GroupName="taskest" Style="{StaticResource NavButton}"/>
                        <RadioButton x:Name="TaskEst3" Content="3" GroupName="taskest" Style="{StaticResource NavButton}"/>
                        <RadioButton x:Name="TaskEst4" Content="4" GroupName="taskest" Style="{StaticResource NavButton}"/>
                    </WrapPanel>
                    <TextBlock Text="Tags (optional)" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                    <TextBox x:Name="TaskTagsBox" ToolTip="Separate with commas, like: client, admin"/>
                    <StackPanel x:Name="TaskRepeatRow">
                        <TextBlock Text="Repeats (optional)" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                        <TextBox x:Name="TaskRepeatBox" TextChanged="TaskRepeatBox_TextChanged" ToolTip="Like: every friday, weekdays, every 2 weeks on monday, every month on the 15th, every last friday"/>
                        <TextBlock x:Name="TaskRepeatPreview" Style="{StaticResource Caption}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="TaskRemindRow">
                        <TextBlock Text="Reminder (optional)" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                        <TextBox x:Name="TaskRemindBox" TextChanged="TaskRemindBox_TextChanged" ToolTip="Like: 3pm, tomorrow 9am, friday at 2:30pm"/>
                        <TextBlock x:Name="TaskRemindPreview" Style="{StaticResource Caption}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="TaskStatusRow">
                        <TextBlock Text="Status" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TaskStatusTodo" Content="To do" GroupName="taskstatus" Style="{StaticResource NavButton}"/>
                            <RadioButton x:Name="TaskStatusDoing" Content="Doing" GroupName="taskstatus" Style="{StaticResource NavButton}"/>
                            <RadioButton x:Name="TaskStatusWaiting" Content="Waiting" GroupName="taskstatus" Style="{StaticResource NavButton}"/>
                        </StackPanel>
                        <TextBox x:Name="TaskWaitingBox" Margin="0,6,0,0" ToolTip="Waiting on whom or what? (optional)"/>
                    </StackPanel>
                    <StackPanel x:Name="TaskSubtasksRow">
                        <TextBlock Text="Steps (optional)" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                        <ItemsControl x:Name="TaskSubtaskList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}" Padding="6,0" FontSize="11" Click="RemoveSubtask_Click" ToolTip="Remove step"/>
                                        <CheckBox IsChecked="{Binding Done}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                        </CheckBox>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox x:Name="TaskSubtaskBox" PreviewKeyDown="TaskSubtaskBox_PreviewKeyDown" ToolTip="Type a step and press Enter"/>
                        <TextBlock Text="Notes (optional)" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                        <TextBox x:Name="TaskNotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="160" VerticalScrollBarVisibility="Auto" TextChanged="TaskNotesBox_TextChanged"/>
                        <!-- Scripture references in the task or its notes, as links to Logos -->
                        <TextBlock x:Name="TaskRefsText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel x:Name="TaskSnoozeRow">
                        <TextBlock Text="Snooze (hide from the bin until a day)" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TaskSnoozeBox" Width="140" ToolTip="Like: monday, next week, 10/20. Empty: not snoozed."/>
                            <Button Content="Tomorrow" Style="{StaticResource LinkButton}" Click="SnoozeTomorrow_Click" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <Button Content="Next week" Style="{StaticResource LinkButton}" Click="SnoozeNextWeek_Click" VerticalAlignment="Center"/>
                            <Button Content="None" Style="{StaticResource LinkButton}" Click="SnoozeNone_Click" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <CheckBox x:Name="TaskTodayCheck" Content="Do this today" Margin="0,12,0,0"/>
                    <TextBlock x:Name="TaskInfoText" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock x:Name="TaskPopupNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <DockPanel Margin="0,14,0,0">
                        <Button Content="Delete" Click="TaskPopupDelete_Click"/>
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Padding="20,8" HorizontalAlignment="Right" Click="TaskPopupSave_Click"/>
                    </DockPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- ===== Saved layouts ===== -->
        <Popup x:Name="LayoutsPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="18" Width="300" MaxHeight="520" Margin="0,6,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Saved layouts" Style="{StaticResource SubHeading}"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,14" Text="Save the plan on screen to reuse it, like a Tuesday layout. Load one to replace the plan on screen. Right-click a layout to delete it."/>
                        <TextBlock Text="Layout name" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <TextBox x:Name="LayoutNameBox" KeyDown="LayoutName_KeyDown"/>
                        <Button x:Name="SaveLayoutBtn" Content="Save layout" Click="SaveLayout_Click" Margin="0,8,0,16"/>
                    </StackPanel>
                    <Grid>
                        <TextBlock x:Name="NoLayoutsHint" IsHitTestVisible="False" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="No saved layouts yet."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LayoutList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Panel2}" CornerRadius="10" Padding="12,8,8,8" Margin="0,0,0,8">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Load layout" Click="LoadLayout_Click"/>
                                                    <MenuItem Header="Delete layout" Click="DeleteLayout_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Load" Padding="12,5" Background="{DynamicResource Panel3}" Margin="6,0,0,0" Click="LoadLayout_Click"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Popup>

        <!-- ===== New template ===== -->
        <Popup x:Name="TemplatePopup" StaysOpen="False" AllowsTransparency="True" Placement="Left" PopupAnimation="Fade">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="18" Width="360" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="New template" Style="{StaticResource SubHeading}"/>
                    <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                    <TextBox x:Name="TemplateNameBox"/>
                    <TextBlock Text="Tasks, one per line (shortcuts like @label, #Project and ! work)" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                    <TextBox x:Name="TemplateLinesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="160" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock x:Name="TemplateNote" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" Click="TemplateCancel_Click" Margin="0,0,8,0"/>
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="TemplateSave_Click" Padding="20,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ===== Edit a block (opens when you click one) ===== -->
        <Popup x:Name="BlockPopup" StaysOpen="True" AllowsTransparency="True" Placement="MousePoint" PopupAnimation="Fade" Closed="BlockPopup_Closed">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="20,16" Width="360" Margin="8" PreviewKeyDown="BlockPopup_PreviewKeyDown">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}" Click="BlockPopupClose_Click" ToolTip="Close (Ctrl+Enter or Esc). Changes are saved as you type."/>
                        <TextBlock Text="Edit" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer x:Name="EditorPanel" VerticalScrollBarVisibility="Auto" MaxHeight="600">
                        <StackPanel>
                            <TextBlock x:Name="EditorKind" Text="{Binding KindLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FocusBrush}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,14">
                                <Run Text="Starts at"/> <Run Text="{Binding StartLabel, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock x:Name="EditorAnchorNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14" Visibility="Collapsed"/>
                            <TextBlock Text="Title" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="EditorTitleBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Length" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                            <local:NumberBox x:Name="EditorMinutes" Value="{Binding Minutes}" Suffix="min" Width="130" HorizontalAlignment="Left" Minimum="1" Maximum="600"/>

                            <StackPanel x:Name="EditorBlocking">
                                <TextBlock Text="Blocked during this session" Style="{StaticResource Caption}" Margin="0,18,0,8"/>
                                <ItemsControl ItemsSource="{Binding UsedLists}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}" Background="{DynamicResource FocusTint}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" list" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                                    <Button Content="✕" Style="{StaticResource IconButton}" Padding="6,0" FontSize="11" Click="RemoveListFromBlock_Click" ToolTip="Stop using this list here" Visibility="{Binding DataContext.RemoveVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding BlockedApps}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                    <Button Content="✕" Style="{StaticResource IconButton}" Padding="6,0" FontSize="11" Click="RemoveAppFromBlock_Click" ToolTip="Unblock this app here" Visibility="{Binding DataContext.RemoveVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="+ Block apps" Click="EditorBlockApps_Click" Margin="0,0,8,0"/>
                                    <Button Content="+ Block list" Click="EditorBlockList_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="EditorSites" Visibility="Collapsed">
                                <TextBlock Text="Websites for this session" Style="{StaticResource Caption}" Margin="0,18,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="EditorSitesBlock" Content="Block these" GroupName="edsites" Style="{StaticResource NavButton}" Checked="EditorSitesMode_Changed"/>
                                    <RadioButton x:Name="EditorSitesAllow" Content="Block all except these" GroupName="edsites" Style="{StaticResource NavButton}" Checked="EditorSitesMode_Changed"/>
                                </StackPanel>
                                <StackPanel x:Name="EditorSitesHost"/>
                            </StackPanel>
                            <StackPanel x:Name="EditorTasks">
                                <TextBlock Text="Tasks for this session" Style="{StaticResource Caption}" Margin="0,18,0,8"/>
                                <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="{DynamicResource TaskRowMargin}" Background="{DynamicResource Panel}">
                                                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}" Padding="6,0" FontSize="11" Click="RemoveTask_Click" VerticalAlignment="Top" ToolTip="Take off this session (unfinished tasks go to your task list)"/>
                                                <CheckBox x:Name="Check" DockPanel.Dock="Left" IsChecked="{Binding Done}" VerticalAlignment="Top" Margin="0,2,10,0" Style="{StaticResource TaskCheck}" ToolTip="Done"/>
                                                <StackPanel Background="Transparent" Cursor="Hand" MouseLeftButtonUp="EditorTaskText_Click" ToolTip="Click to edit: priority, due date, estimate, tags">
                                                    <TextBlock x:Name="TaskText" Text="{Binding Text}" TextWrapping="Wrap" FontSize="{DynamicResource TaskFontSize}"/>
                                                    <TextBlock x:Name="TaskDetails" Text="{Binding Details}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Done}" Value="True">
                                                    <Setter TargetName="TaskText" Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter TargetName="TaskText" Property="Foreground" Value="{DynamicResource Muted}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasDetails}" Value="False">
                                                    <Setter TargetName="TaskDetails" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                    <Setter TargetName="TaskDetails" Property="Foreground" Value="{DynamicResource MeetingBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                    <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource PriorityHigh}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                    <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource PriorityLow}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox x:Name="NewTaskBox" PreviewKeyDown="NewTaskBox_PreviewKeyDown" ToolTip="Type a task and press Enter"/>
                                <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,6" Text="Type a task and press Enter."/>
                                <Button Content="+ From task list" Click="FromBin_Click" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <TextBlock x:Name="EditorRunningNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,18,0,0" Visibility="Collapsed" Text="Your day is running. Anything that hasn't started yet can be moved, resized, added or deleted, and the session happening now can be made longer. Nothing can be unblocked until the day ends."/>

                            <WrapPanel x:Name="EditorActions" Margin="0,22,0,0">
                                <Button Content="Duplicate" Click="Duplicate_Click" Margin="0,0,8,8"/>
                                <Button Content="Copy" Click="Copy_Click" Margin="0,0,8,8"/>
                                <Button Content="Paste below" Click="Paste_Click" Margin="0,0,8,8"/>
                                <Button Content="Move up" Click="MoveUp_Click" Margin="0,0,8,8"/>
                                <Button Content="Move down" Click="MoveDown_Click" Margin="0,0,8,8"/>
                                <Button Content="Delete" Click="Remove_Click" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="MakeFocusBtn" Content="Make this a focus session" Click="MakeFocus_Click" Margin="0,10,0,0" HorizontalAlignment="Left" Visibility="Collapsed"/>
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,10,0,0" Text="Saved as you type. Ctrl+Enter or Esc closes."/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ===== Extend the current session ===== -->
        <Popup x:Name="ExtendPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="18,14" Width="300" Margin="0,6,0,0" PreviewKeyDown="ExtendPopup_PreviewKeyDown">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="ExtendValue" DockPanel.Dock="Right" FontSize="20" FontWeight="SemiBold" Text="+10 min"/>
                        <TextBlock Text="Extend this session" Style="{StaticResource SubHeading}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Slider x:Name="ExtendSlider" Minimum="1" Maximum="60" Value="10" TickFrequency="5" IsSnapToTickEnabled="False" SmallChange="1" LargeChange="5" Margin="0,12,0,4" ValueChanged="ExtendSlider_ValueChanged"/>
                    <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Text="Slide (or use the arrow keys), then press Enter. In a day plan, the time comes from the blocks after this one."/>
                    <Button Content="Extend" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="18,7" Click="ExtendApply_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ===== Edit a project: name, shortcuts, sections ===== -->
        <Popup x:Name="ProjectPopup" StaysOpen="False" AllowsTransparency="True" Placement="Left" PopupAnimation="Fade">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="18" Width="340" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Project" Style="{StaticResource SubHeading}"/>
                    <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                    <TextBox x:Name="ProjectNameBox"/>
                    <TextBlock Text="Color" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                    <WrapPanel x:Name="ProjectColors"/>
                    <TextBlock Text="Shortcuts (type #shortcut when adding a task)" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                    <TextBox x:Name="ProjectAliasBox" ToolTip="Separate with commas, like: goj, gj, 1"/>
                    <TextBlock Text="Sections (type /Section after the project)" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                    <TextBox x:Name="ProjectSectionsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" ToolTip="One section per line. Renaming a line renames the section; removing a line takes its tasks out of it."/>
                    <TextBlock x:Name="ProjectNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <DockPanel Margin="0,12,0,0">
                        <Button Content="Delete project" Click="ProjectDelete_Click"/>
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="20,8" Click="ProjectSave_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ===== Edit the sites in a website category ===== -->
        <Popup x:Name="CategoryPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="18" Width="340" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock x:Name="CategoryTitle" Style="{StaticResource SubHeading}"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,8" Text="One site per line. Subdomains are included (youtube.com covers m.youtube.com)."/>
                    <TextBox x:Name="CategorySitesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="200" VerticalScrollBarVisibility="Auto"/>
                    <DockPanel Margin="0,12,0,0">
                        <Button Content="Reset to built-in" Click="CategoryReset_Click"/>
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="20,8" Click="CategorySave_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ===== Task list picker ===== -->
        <Popup x:Name="BinPickerPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade" Closed="BinPickerPopup_Closed">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="16" Width="340" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Task list" Style="{StaticResource SubHeading}"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12" Text="Check the tasks to move onto this session."/>
                    <TextBlock x:Name="BinPickerEmpty" Style="{StaticResource Caption}" Text="Your task list is empty."/>
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="BinPickerList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,8,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Content="Done" Style="{StaticResource PrimaryButton}" Padding="20,8" Margin="0,8,0,0" HorizontalAlignment="Right" Click="BinPickerDone_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ===== Sidebar ===== -->
        <Border x:Name="SidebarBorder" Grid.RowSpan="4" Width="232" HorizontalAlignment="Left" Background="{DynamicResource Sidebar}" Padding="12,18,12,14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="8,0,0,20">
                    <Button x:Name="CollapseBtn" DockPanel.Dock="Right" Content="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource IconButton}" FontSize="12" Click="CollapseSidebar_Click" ToolTip="Shrink the sidebar to icons (Ctrl+\)" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="SidebarTitle" Text="Focus" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource HeadingFont}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Button DockPanel.Dock="Top" Click="SideAddTask_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Padding="10,7" Margin="0,0,0,10" ToolTip="Add a task to your list">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="20">
                            <Ellipse Fill="{DynamicResource FocusBrush}"/>
                            <TextBlock Text="+" Foreground="{DynamicResource OnAccent}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Grid>
                        <TextBlock x:Name="AddTaskLabel" Text="Add task" Foreground="{DynamicResource FocusBrush}" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="NoticeBell" DockPanel.Dock="Top" Click="NoticeBell_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="10,6" Margin="0,0,0,8" ToolTip="Notifications from Focus">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="22">
                            <TextBlock Text="🔔" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center"/>
                            <Border x:Name="NoticeBadge" Background="{DynamicResource FocusBrush}" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0" Visibility="Collapsed">
                                <TextBlock x:Name="NoticeCount" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="NoticeLabel" Text="Notifications" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavHome" Content="Home" Tag="" GroupName="nav" Style="{StaticResource SideNavButton}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavDashboard" Content="Dashboard" Tag="" GroupName="nav" IsChecked="True" Style="{StaticResource SideNavButton}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavPlan" Content="Day plan" Tag="" GroupName="nav" Style="{StaticResource SideNavButton}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavCalendar" Content="Calendar" Tag="" GroupName="nav" Style="{StaticResource SideNavButton}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavTasks" Content="Tasks" Tag="" GroupName="nav" Style="{StaticResource SideNavButton}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavPersonal" Content="Personal" Tag="" GroupName="nav" Style="{StaticResource SideNavButton}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavStats" Content="Stats" Tag="" GroupName="nav" Style="{StaticResource SideNavButton}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavLists" Content="Block lists" Tag="" GroupName="nav" Style="{StaticResource SideNavButton}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavTraining" Content="Training" Tag="&#xE736;" GroupName="nav" Style="{StaticResource SideNavButton}" Checked="Nav_Checked" ToolTip="Your books: daily lessons, chapter packs, notes"/>
                    <RadioButton x:Name="NavPomodoro" Content="Pomodoro" Tag="" GroupName="nav" Style="{StaticResource SideNavButton}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavFocus" Content="Quick focus" Tag="" GroupName="nav" Style="{StaticResource SideNavButton}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Content="Settings" Tag="" GroupName="nav" Style="{StaticResource SideNavButton}" Checked="Nav_Checked"/>
                </StackPanel>
                <!-- Daily goal and streak -->
                <Border x:Name="GoalWidget" DockPanel.Dock="Bottom" Padding="10,10" CornerRadius="8" Background="{DynamicResource Panel}" ToolTip="Your daily goal: hit either the tasks or the focus hours. Weekends never break a streak.">
                    <StackPanel>
                        <TextBlock x:Name="GoalTitle" Text="Today's goal" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="GoalTasksText" Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,0"/>
                        <ProgressBar x:Name="GoalTasksBar" Style="{StaticResource Bar}" Height="4" Maximum="1" Margin="0,3,0,0"/>
                        <TextBlock x:Name="GoalFocusText" Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,0"/>
                        <ProgressBar x:Name="GoalFocusBar" Style="{StaticResource Bar}" Height="4" Maximum="1" Margin="0,3,0,0"/>
                        <TextBlock x:Name="StreakText" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource FocusBrush}"/>
                    </StackPanel>
                </Border>
                <Border/>
            </DockPanel>
        </Border>

        <!-- ===== Current session strip (while something runs) ===== -->
        <Border x:Name="RunPanel" Grid.Column="1" Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="10" Padding="0" Margin="0,0,0,12" Visibility="Collapsed">
            <DockPanel>
                <!-- A slim strip: what's on, time left, and the controls, in one row -->
                <ProgressBar x:Name="RunProgress" DockPanel.Dock="Bottom" Style="{StaticResource Bar}" Height="3" Minimum="0" Maximum="1" Margin="10,0,10,0"/>
                <Border x:Name="RunStripe" DockPanel.Dock="Left" Width="5" CornerRadius="10,0,0,10" Background="{DynamicResource FocusBrush}"/>
                <Grid Margin="16,8,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RunKind" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FocusBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="RunName" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock x:Name="RunNext" Style="{StaticResource Caption}" FontSize="12" Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="RunBlocking" Style="{StaticResource Caption}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="RunTime" Grid.Column="1" FontSize="24" FontFamily="{StaticResource HeadingFont}" VerticalAlignment="Center" Margin="16,0,16,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LockedNote" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="240" Margin="0,0,10,0" Visibility="Collapsed"/>
                        <StackPanel x:Name="PassButtons" Orientation="Horizontal" Margin="0,0,10,0" Visibility="Collapsed">
                            <Button Content="3 min" Click="Pass3_Click" Margin="0,0,6,0" Padding="10,5" ToolTip="Unblock your apps for 3 minutes"/>
                            <Button Content="8 min" Click="Pass8_Click" Padding="10,5" ToolTip="Unblock your apps for 8 minutes"/>
                        </StackPanel>
                        <StackPanel x:Name="PassActivePanel" Orientation="Horizontal" Margin="0,0,10,0" Visibility="Collapsed">
                            <TextBlock x:Name="PassText" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="End break" Click="EndPass_Click" Padding="10,5"/>
                        </StackPanel>
                        <Button Content="Extend" Click="Extend_Click" Margin="0,0,6,0" Padding="10,5" ToolTip="Add time to this session (Ctrl+E)"/>
                        <Button x:Name="PauseBtn" Content="Pause" Click="Pause_Click" Margin="0,0,6,0" MinWidth="70" Padding="10,5"/>
                        <Button x:Name="SkipBtn" Content="Skip" Click="Skip_Click" Margin="0,0,6,0" Padding="10,5"/>
                        <Button x:Name="StopBtn" Content="Stop" Click="Stop_Click" Padding="10,5"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===== Day plan ===== -->
        <Grid x:Name="PlanPanel" Grid.Column="1" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition x:Name="PlanTasksColumn" Width="320" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Timeline -->
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="‹" Click="PrevDay_Click" Padding="12,4" FontSize="16" ToolTip="Previous day"/>
                            <Button Content="›" Click="NextDay_Click" Padding="12,4" FontSize="16" Margin="6,0,10,0" ToolTip="Next day"/>
                            <TextBlock x:Name="PlanDateText" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
                            <Button x:Name="TodayBtn" Content="Today" Style="{StaticResource LinkButton}" Margin="10,0,0,0" VerticalAlignment="Center" Click="Today_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="PlanStatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Day starts at" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="DayStartBox" Width="96" LostFocus="DayStart_LostFocus" KeyDown="DayStart_KeyDown" ToolTip="Type a time, or leave it on the current time"/>
                            <TextBlock x:Name="DayStartAutoText" Text="Now, follows the clock" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Button x:Name="DayStartNowBtn" Content="Use current time" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" Click="DayStartNow_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="PlanSummary" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    </StackPanel>

                    <WrapPanel x:Name="PlanToolbar" Grid.Row="1" Margin="0,14,0,12">
                        <Button Content="+ Focus session" Click="AddFocus_Click" Margin="0,0,8,6"/>
                        <Button Content="+ Break" Click="AddBreak_Click" Margin="0,0,8,6"/>
                        <Button Content="+ Session and break" Click="AddPair_Click" Margin="0,0,8,6"/>
                        <Button x:Name="FillPartBtn" Content="Fill part of day" Click="FillPart_Click" Margin="0,0,8,6" ToolTip="Drag across the calendar to fill just that time with focus sessions and breaks"/>
                        <Button x:Name="LayoutsBtn" Content="Layouts" Click="Layouts_Click" Margin="0,0,8,6" ToolTip="Save this plan as a layout, or load a saved one"/>
                        <Button x:Name="UndoPlanBtn" Content="Undo" Click="Undo_Click" Margin="0,0,8,6" ToolTip="Undo the last change (Ctrl+Z)"/>
                        <Button x:Name="AdjustDayBtn" Content="Adjust working day" Click="AdjustDay_Click" Margin="0,0,8,6" ToolTip="Change when this day starts and ends; sessions and breaks fill the new hours"/>
                        <Button x:Name="AutoFillBtn" Content="Auto-fill day" Click="AutoFill_Click" Margin="0,0,8,6" ToolTip="Plan this day around your meetings, the 10:05 break and lunch"/>
                        <Button x:Name="ClearBtn" Content="Clear" Click="Clear_Click" Margin="0,0,8,6"/>
                    </WrapPanel>

                    <local:DayTimeline x:Name="Timeline" Grid.Row="2"/>
                    <Border x:Name="FillPartHint" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0" Background="{DynamicResource Text}" CornerRadius="16" Padding="14,6" IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock Text="Drag across the calendar to choose the time to fill. Click the button again to cancel." Foreground="{DynamicResource Bg}" FontSize="12.5"/>
                    </Border>
                    <TextBlock x:Name="EmptyPlanHint" Grid.Row="2" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="70,20,0,0" Visibility="Collapsed" IsHitTestVisible="False" Text="Your day is empty. Add a focus session to get started, or load a saved layout."/>

                    <DockPanel Grid.Row="3" Margin="0,14,0,0">
                        <Button x:Name="StartDayBtn" DockPanel.Dock="Right" Content="Start my day" Style="{StaticResource PrimaryButton}" Click="StartDay_Click" ToolTip="Starts on the clock: if you start late, you join whichever session is happening now"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="AutoStartCheck" Content="Start this day automatically" VerticalAlignment="Center" Margin="0,0,22,0" FontWeight="SemiBold" Checked="AutoStartCheck_Changed" Unchecked="AutoStartCheck_Changed" ToolTip="Focus starts this plan by itself when its first session begins. Focus just needs to be running (it starts with Windows)."/>
                            <CheckBox x:Name="LockedCheckPlan" Content="Locked mode" VerticalAlignment="Center" Checked="LockedCheck_Changed" Unchecked="LockedCheck_Changed" ToolTip="The only way to end a focus session early is to quit Focus."/>
                            <CheckBox x:Name="ExtremeCheckPlan" Content="Extreme" VerticalAlignment="Center" Margin="18,0,0,0" Checked="ExtremeCheck_Changed" Unchecked="ExtremeCheck_Changed" ToolTip="You also can't quit Focus during focus sessions, and it reopens itself if force-closed."/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="NoSelectionHint" Visibility="Collapsed" IsHitTestVisible="False"/>
            <GridSplitter Grid.Column="1" Style="{StaticResource Divider}" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ToolTip="Drag to resize" DragCompleted="PlanSplitter_DragCompleted"/>
            <!-- Your tasks: drag them onto focus sessions -->
            <Border Grid.Column="2" Background="{DynamicResource Panel}" CornerRadius="10" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="PlanTasksDay" Content="Today" GroupName="plantasks" Style="{StaticResource NavButton}" Checked="PlanTasksView_Checked" ToolTip="Tasks picked for this day, due this day, or already placed in its sessions"/>
                                <RadioButton x:Name="PlanTasksAll" Content="All" GroupName="plantasks" IsChecked="True" Style="{StaticResource NavButton}" Checked="PlanTasksView_Checked"/>
                                <RadioButton x:Name="PlanTasksUndated" Content="Undated" GroupName="plantasks" Style="{StaticResource NavButton}" Checked="PlanTasksView_Checked" ToolTip="Tasks with no due date and not picked for a day"/>
                            </StackPanel>
                            <TextBlock Text="Tasks" Style="{StaticResource SubHeading}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,10" Text="Drag a task onto a focus session. It stays here until you finish it, so you can add it to several sessions."/>
                        <Grid Margin="0,0,0,6">
                            <TextBox x:Name="PlanTaskSearch" TextChanged="PlanTaskSearch_TextChanged"/>
                            <TextBlock x:Name="PlanTaskSearchHint" Text="Search" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBox x:Name="PlanTaskAdd" PreviewKeyDown="PlanTaskAdd_PreviewKeyDown" TextChanged="PlanTaskAdd_TextChanged"/>
                            <TextBlock x:Name="PlanTaskAddHint" Text="Add a task" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>
                    <Grid>
                        <TextBlock x:Name="PlanTasksEmpty" IsHitTestVisible="False" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="No tasks. Add one above, or in the Tasks tab."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PlanTaskList">
                                <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Background="{DynamicResource TaskRowBg}" CornerRadius="{DynamicResource TaskRowCorner}" Padding="{DynamicResource TaskRowPadding}" Margin="{DynamicResource TaskRowMargin}" BorderBrush="{DynamicResource TaskRowLine}" BorderThickness="{DynamicResource TaskRowLineThickness}" MouseRightButtonUp="TaskRow_RightClick" Cursor="Hand" ToolTip="Drag onto a focus session. Click to edit." PreviewMouseLeftButtonDown="PlanTask_MouseDown" PreviewMouseMove="PlanTask_MouseMove">
                                        <DockPanel>
                                            <CheckBox x:Name="Check" DockPanel.Dock="Left" Style="{StaticResource TaskCheck}" VerticalAlignment="Top" Margin="0,2,10,0" Click="PlanTaskCheck_Click" ToolTip="Finish this task"/>
                                            <StackPanel Background="Transparent" Cursor="Hand" MouseLeftButtonUp="PlanTaskText_Click" ToolTip="Click to edit. Double-click to rename. Right-click for more.">
                                                <TextBlock x:Name="Title" local:ScriptureLinks.Text="{Binding Task.Text}" TextWrapping="Wrap" FontSize="{DynamicResource TaskFontSize}"/>
                                                <TextBox x:Name="RenameBox" Text="{Binding Task.Text, UpdateSourceTrigger=Explicit}" Visibility="Collapsed" FontSize="{DynamicResource TaskFontSize}" PreviewKeyDown="RenameBox_PreviewKeyDown" LostFocus="RenameBox_LostFocus"/>
                                                <TextBlock x:Name="Details" Text="{Binding Task.Details}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Sessions}" FontSize="11.5" Foreground="{DynamicResource FocusBrush}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Task.HasDetails}" Value="False">
                                            <Setter TargetName="Details" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Task.IsOverdue}" Value="True">
                                            <Setter TargetName="Details" Property="Foreground" Value="{DynamicResource PriorityHigh}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Task.IsHigh}" Value="True">
                                            <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource PriorityHigh}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Task.IsLow}" Value="True">
                                            <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource PriorityLow}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Task.IsSelected}" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource NavSelected}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Task.IsEditing}" Value="True">
                                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="RenameBox" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Home ===== -->
        <Grid x:Name="HomePanel" Grid.Column="1" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Greeting, with today's numbers -->
            <Border x:Name="HomeHero" Grid.ColumnSpan="3" CornerRadius="14" Padding="30,24" Margin="0,0,0,20" Background="{DynamicResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HomeGreeting" FontSize="15" Foreground="{DynamicResource Muted}"/>
                        <TextBlock Text="You're getting stuff done." FontSize="34" FontWeight="SemiBold" FontFamily="{StaticResource HeadingFont}" Margin="0,4,0,8"/>
                        <TextBlock x:Name="HomeSubline" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="HomeStartBtn" Content="Start my day" Style="{StaticResource PrimaryButton}" Click="StartDay_Click" Margin="0,0,10,0"/>
                            <Button x:Name="HomeOpenDashBtn" Content="Open dashboard" Click="HomeOpenDashboard_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                            <Button Content="Plan my day" Click="HomePlanDay_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Small stats box -->
                    <Border Grid.Column="1" Background="{DynamicResource Panel}" CornerRadius="12" Padding="22,16" Margin="24,0,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="96"/>
                                <ColumnDefinition Width="Auto" MinWidth="96"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,18,12">
                                <TextBlock x:Name="HomeDoneToday" FontSize="26" FontFamily="{StaticResource HeadingFont}" Foreground="{DynamicResource FocusBrush}"/>
                                <TextBlock Text="done today" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock x:Name="HomeFocusToday" FontSize="26" FontFamily="{StaticResource HeadingFont}"/>
                                <TextBlock Text="focus today" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,18,0">
                                <TextBlock x:Name="HomeWeek" FontSize="26" FontFamily="{StaticResource HeadingFont}"/>
                                <TextBlock Text="done this week" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock x:Name="HomeStreak" FontSize="26" FontFamily="{StaticResource HeadingFont}"/>
                                <TextBlock x:Name="HomeStreakLabel" Text="day streak" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Today's calendar -->
            <Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="12" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <CheckBox x:Name="HomeShowPlanCheck" DockPanel.Dock="Right" Content="Show my plan" VerticalAlignment="Center" Checked="HomeShowPlan_Changed" Unchecked="HomeShowPlan_Changed" ToolTip="Untick to see only your calendar events"/>
                        <StackPanel>
                            <TextBlock Text="Today" Style="{StaticResource SubHeading}"/>
                            <TextBlock x:Name="HomeNowText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <local:DayTimeline x:Name="HomeDay" Grid.Row="1"/>
                </Grid>
            </Border>

            <!-- Your tasks -->
            <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource Panel}" CornerRadius="12" Padding="20,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="HomeTasksToday" Content="Today" GroupName="hometasks" IsChecked="True" Style="{StaticResource NavButton}" Checked="HomeTasksView_Checked"/>
                                <RadioButton x:Name="HomeTasksAll" Content="All" GroupName="hometasks" Style="{StaticResource NavButton}" Checked="HomeTasksView_Checked"/>
                            </StackPanel>
                            <TextBlock Text="Tasks" Style="{StaticResource SubHeading}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBox x:Name="HomeTaskAdd" PreviewKeyDown="HomeTaskAdd_PreviewKeyDown" TextChanged="HomeTaskAdd_TextChanged" FontSize="{DynamicResource TaskFontSize}"/>
                            <TextBlock x:Name="HomeTaskAddHint" Text="+  Add a task" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>
                    <Grid>
                        <TextBlock x:Name="HomeTasksEmpty" IsHitTestVisible="False" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="HomeTaskList">
                                <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Background="{DynamicResource TaskRowBg}" CornerRadius="{DynamicResource TaskRowCorner}" Padding="{DynamicResource TaskRowPadding}" Margin="{DynamicResource TaskRowMargin}" BorderBrush="{DynamicResource TaskRowLine}" BorderThickness="{DynamicResource TaskRowLineThickness}" MouseRightButtonUp="TaskRow_RightClick">
                                        <DockPanel>
                                            <CheckBox x:Name="Check" DockPanel.Dock="Left" Style="{StaticResource TaskCheck}" VerticalAlignment="Top" Margin="0,2,10,0" Click="ResolveBinTask_Click" ToolTip="Finish this task"/>
                                            <StackPanel Background="Transparent" Cursor="Hand" MouseLeftButtonUp="BinTaskText_Click" ToolTip="Click to edit. Double-click to rename. Right-click for more.">
                                                <TextBlock x:Name="Title" local:ScriptureLinks.Text="{Binding Text}" TextWrapping="Wrap" FontSize="{DynamicResource TaskFontSize}"/>
                                                <TextBox x:Name="RenameBox" Text="{Binding Text, UpdateSourceTrigger=Explicit}" Visibility="Collapsed" FontSize="{DynamicResource TaskFontSize}" PreviewKeyDown="RenameBox_PreviewKeyDown" LostFocus="RenameBox_LostFocus"/>
                                                <TextBlock x:Name="Details" Text="{Binding Details}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasDetails}" Value="False">
                                            <Setter TargetName="Details" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter TargetName="Details" Property="Foreground" Value="{DynamicResource PriorityHigh}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                            <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource PriorityHigh}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                                            <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource PriorityLow}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource NavSelected}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="RenameBox" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Dashboard ===== -->
        <Grid x:Name="DashboardPanel" Grid.Column="1" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition x:Name="DashRightColumn" Width="440" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Style="{StaticResource Divider}" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ToolTip="Drag to resize" DragCompleted="DashSplitter_DragCompleted"/>
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="DashTitle" Text="Today" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton x:Name="DashDayView" Content="Day" GroupName="dashview" IsChecked="True" Style="{StaticResource NavButton}" Checked="DashView_Checked"/>
                            <RadioButton x:Name="DashWeekView" Content="Week" GroupName="dashview" Style="{StaticResource NavButton}" Checked="DashView_Checked"/>
                                                    <CheckBox x:Name="DashShowPlanCheck" Content="Show my plan" VerticalAlignment="Center" Margin="12,0,0,0" Checked="WeekShowPlan_Changed" Unchecked="WeekShowPlan_Changed" Visibility="Collapsed" ToolTip="Untick to see only your calendar events"/>
                        </StackPanel>
                    </DockPanel>
                    <local:DayTimeline x:Name="DashDay" Grid.Row="1"/>
                    <local:WeekTimeline x:Name="DashWeek" Grid.Row="1" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource Panel}" CornerRadius="10" Padding="22,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- The current session -->
                        <!-- The timer, with your focus totals beside it -->
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Centered over the ring (column 0), not over the ring and totals together -->
                            <!-- Focus sessions: the numeral badge (session number in a serif ring) and FOCUS SESSION or the session's name -->
                            <StackPanel x:Name="DashHeader" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <Border x:Name="DashBadge" MinWidth="30" Height="30" CornerRadius="15" BorderThickness="1.5" BorderBrush="{DynamicResource FocusBrush}"
                                        Padding="4,0" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="DashBadgeText" FontSize="15" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                </Border>
                                <TextBlock x:Name="DashKind" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" Foreground="{DynamicResource FocusBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="DashName" Grid.Row="1" Style="{StaticResource SubHeading}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,14" MaxWidth="260"/>
                            <Grid Grid.Row="2">
                                <local:RingTimer x:Name="DashTimer"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="150">
                                    <TextBlock x:Name="DashMinutes" FontSize="34" FontWeight="Light" FontFamily="{StaticResource HeadingFont}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DashMinutesCaption" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" Margin="22,0,0,0" ToolTip="Focus hours with blocking. Only focus sessions that block at least one app count; paused time and short breaks don't.">
                                <TextBlock x:Name="DashToday" FontSize="20" FontFamily="{StaticResource HeadingFont}"/>
                                <TextBlock Text="done today" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
                                <TextBlock x:Name="DashLeft" FontSize="20" FontFamily="{StaticResource HeadingFont}"/>
                                <TextBlock Text="still planned" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
                                <TextBlock x:Name="DashWeekTotal" FontSize="20" FontFamily="{StaticResource HeadingFont}"/>
                                <TextBlock Text="this week" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="DashNext" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <TextBlock x:Name="DashBlocking" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

                        <StackPanel x:Name="DashControls" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Content="Extend" Click="Extend_Click" Margin="0,0,8,0" ToolTip="Add time to this session (Ctrl+E)"/>
                            <Button x:Name="DashPauseBtn" Content="Pause" Click="Pause_Click" Margin="0,0,8,0" MinWidth="76" ToolTip="Pause or resume (Space)"/>
                            <Button x:Name="DashSkipBtn" Content="Skip" Click="Skip_Click" Margin="0,0,8,0"/>
                            <Button x:Name="DashStopBtn" Content="Stop" Click="Stop_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="DashLockedNote" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                        <StackPanel x:Name="DashPassButtons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed">
                            <Button Content="3-minute break" Click="Pass3_Click" Margin="0,0,8,0"/>
                            <Button Content="8-minute break" Click="Pass8_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="DashPassActive" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="DashPassText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="End break now" Click="EndPass_Click"/>
                        </StackPanel>
                        <Button x:Name="DashStartBtn" Content="Start my day" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,12,0,0" Click="StartDay_Click" Visibility="Collapsed"/>
                        <!-- Shown when nothing is running -->
                        <Border x:Name="DashIdleCard" Background="{DynamicResource FocusTint}" CornerRadius="10" Padding="16,12" Margin="0,14,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="You're getting stuff done." FontSize="17" FontWeight="SemiBold" FontFamily="{StaticResource HeadingFont}"/>
                                <TextBlock x:Name="DashIdleNumbers" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock x:Name="DashIdleNext" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Tasks, right under the timer -->
                        <Border x:Name="DashTasksPanel" Background="{DynamicResource Panel2}" CornerRadius="10" Padding="16,14" Margin="0,18,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="DashTasksSession" Content="Session" GroupName="dashtasks" IsChecked="True" Style="{StaticResource NavButton}" Checked="DashTasksView_Checked" ToolTip="This focus session's tasks"/>
                                        <RadioButton x:Name="DashTasksToday" Content="Today" GroupName="dashtasks" Style="{StaticResource NavButton}" Checked="DashTasksView_Checked" ToolTip="Tasks picked for today, due today, overdue, or in today's sessions"/>
                                        <RadioButton x:Name="DashTasksAll" Content="All" GroupName="dashtasks" Style="{StaticResource NavButton}" Checked="DashTasksView_Checked"/>
                                        <RadioButton x:Name="DashTasksUndated" Content="Undated" GroupName="dashtasks" Style="{StaticResource NavButton}" Checked="DashTasksView_Checked" ToolTip="Tasks with no due date and not picked for a day"/>
                                        <Button x:Name="DashOverlayBtn" Content="🌡" FontFamily="Segoe UI Emoji" FontSize="12" Style="{StaticResource IconButton}" Click="DashOverlay_Click" Margin="4,0,0,0" ToolTip="Show or hide the floating timer"/>
                                        <Button x:Name="DashConceptsBtn" Content="Q&amp;A" FontSize="11" FontWeight="SemiBold" Style="{StaticResource IconButton}" Click="DashConcepts_Click" Margin="4,0,0,0" ToolTip="Review your concepts (questions and answers), for as many rounds as you like"/>
                                        <Button x:Name="DashAlphaBtn" Content="αβγ" FontSize="12" FontWeight="SemiBold" Style="{StaticResource IconButton}" Click="DashAlpha_Click" Margin="4,0,0,0" ToolTip="Review the Greek alphabet's sounds, for as many rounds as you like"/>
                                        <Button x:Name="DashGreekBtn" Content="Αα" FontSize="13" FontWeight="SemiBold" Style="{StaticResource IconButton}" Click="DashGreek_Click" Margin="4,0,0,0" ToolTip="Review Greek words now, for as many rounds as you like"/>
                                        <Button x:Name="DashPrintBtn" Content="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource IconButton}" Click="DashPrint_Click" Margin="4,0,0,0" ToolTip="Print tasks (Ctrl+P)"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DashTasksTitle" Text="Tasks for this session" Style="{StaticResource SubHeading}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock x:Name="DashNoTasks" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" Text="No tasks yet. Add one below."/>
                                <ItemsControl x:Name="DashTasksList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource TaskRowBg}" CornerRadius="{DynamicResource TaskRowCorner}" Padding="{DynamicResource TaskRowPadding}" Margin="{DynamicResource TaskRowMargin}" BorderBrush="{DynamicResource TaskRowLine}" BorderThickness="{DynamicResource TaskRowLineThickness}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}" Padding="6,0" FontSize="11" Click="RemoveDashTask_Click" VerticalAlignment="Top" ToolTip="Take off this session (unfinished tasks go to your task list)"/>
                                                <CheckBox x:Name="Check" DockPanel.Dock="Left" IsChecked="{Binding Done}" VerticalAlignment="Top" Margin="0,2,10,0" Style="{StaticResource TaskCheck}" ToolTip="Done"/>
                                                <StackPanel Background="Transparent" Cursor="Hand" MouseLeftButtonUp="DashTaskText_Click" ToolTip="Click to edit: priority, due date, estimate, tags">
                                                    <TextBlock x:Name="TaskText" Text="{Binding Text}" TextWrapping="Wrap" FontSize="{DynamicResource TaskFontSize}"/>
                                                    <TextBlock x:Name="TaskDetails" Text="{Binding Details}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Done}" Value="True">
                                                    <Setter TargetName="TaskText" Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter TargetName="TaskText" Property="Foreground" Value="{DynamicResource Muted}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasDetails}" Value="False">
                                                    <Setter TargetName="TaskDetails" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                    <Setter TargetName="TaskDetails" Property="Foreground" Value="{DynamicResource MeetingBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                    <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource PriorityHigh}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                    <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource PriorityLow}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl x:Name="DashListTasks" Visibility="Collapsed">
                                    <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Background="{DynamicResource TaskRowBg}" CornerRadius="{DynamicResource TaskRowCorner}" Padding="{DynamicResource TaskRowPadding}" Margin="{DynamicResource TaskRowMargin}" BorderBrush="{DynamicResource TaskRowLine}" BorderThickness="{DynamicResource TaskRowLineThickness}" MouseRightButtonUp="TaskRow_RightClick">
                                        <DockPanel>
                                            <CheckBox x:Name="Check" DockPanel.Dock="Left" Style="{StaticResource TaskCheck}" VerticalAlignment="Top" Margin="0,2,10,0" Click="ResolveBinTask_Click" ToolTip="Finish this task"/>
                                            <Button DockPanel.Dock="Right" Content="+ Session" Style="{StaticResource LinkButton}" Click="DashAddToSession_Click" VerticalAlignment="Top" ToolTip="Add this task to the focus session you're in"/>
                                            <StackPanel Background="Transparent" Cursor="Hand" MouseLeftButtonUp="BinTaskText_Click" ToolTip="Click to edit. Double-click to rename. Right-click for more.">
                                                <TextBlock x:Name="Title" local:ScriptureLinks.Text="{Binding Text}" TextWrapping="Wrap" FontSize="{DynamicResource TaskFontSize}"/>
                                                <TextBox x:Name="RenameBox" Text="{Binding Text, UpdateSourceTrigger=Explicit}" Visibility="Collapsed" FontSize="{DynamicResource TaskFontSize}" PreviewKeyDown="RenameBox_PreviewKeyDown" LostFocus="RenameBox_LostFocus"/>
                                                <TextBlock x:Name="Details" Text="{Binding Details}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasDetails}" Value="False">
                                            <Setter TargetName="Details" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter TargetName="Details" Property="Foreground" Value="{DynamicResource PriorityHigh}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                            <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource PriorityHigh}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                                            <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource PriorityLow}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource NavSelected}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="RenameBox" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox x:Name="DashTaskBox" PreviewKeyDown="DashTaskBox_PreviewKeyDown" Margin="0,4,0,0" ToolTip="Type a task and press Enter"/>
                                <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,8" TextWrapping="Wrap" Text="Type a task and press Enter (@label, #Project, ! for high priority). Click a task to edit it. Unchecked tasks go to your task list when the session ends."/>
                                <Button x:Name="DashFromBinBtn" Content="+ From task list" Click="DashFromBin_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Tasks ===== -->
        

        <Grid x:Name="TasksPanel" Grid.Column="1" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>

            <!-- The lists, with as much room as possible -->
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="22,18">
                <DockPanel x:Name="TasksDock">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Tasks" Style="{StaticResource Heading}" VerticalAlignment="Center" x:Name="TasksTitle"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,2,0,0">
                                <Button x:Name="SearchToggle" Content="" Style="{StaticResource IconButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Padding="8,6" VerticalAlignment="Center" Click="SearchToggle_Click" ToolTip="Search (Ctrl+F)"/>
                                <Button x:Name="AddToggle" Content="" Style="{StaticResource IconButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Padding="8,6" VerticalAlignment="Center" Click="AddToggle_Click" ToolTip="Add a task (Ctrl+N)"/>
                                <Button x:Name="ExportBtn" Content="" Style="{StaticResource IconButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Padding="8,6" VerticalAlignment="Center" Click="Export_Click" ToolTip="Print a list (Ctrl+P)"/>
                                <Button x:Name="UndoTasksBtn" Content="" Style="{StaticResource IconButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Padding="8,6" VerticalAlignment="Center" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <RadioButton x:Name="BinTodoView" Content="List" GroupName="binview" IsChecked="True" Style="{StaticResource NavButton}" Checked="BinView_Checked"/>
                                <RadioButton x:Name="BinUndatedView" Content="Undated" GroupName="binview" Style="{StaticResource NavButton}" Checked="BinView_Checked" ToolTip="Tasks with no due date and not picked for a day"/>
                                <RadioButton x:Name="BinTodayView" Content="Today" GroupName="binview" Style="{StaticResource NavButton}" Checked="BinView_Checked" ToolTip="Tasks picked for today, due today, or overdue"/>
                                <RadioButton x:Name="BinTomorrowView" Content="Tomorrow" GroupName="binview" Style="{StaticResource NavButton}" Checked="BinView_Checked" ToolTip="Tasks picked for tomorrow, due tomorrow, or snoozed until tomorrow"/>
                                <RadioButton x:Name="BinUpcomingView" Content="Upcoming" GroupName="binview" Style="{StaticResource NavButton}" Checked="BinView_Checked"/>
                                <RadioButton x:Name="BinBoardView" Content="Board" GroupName="binview" Style="{StaticResource NavButton}" Checked="BinView_Checked"/>
                                <RadioButton x:Name="BinDoneView" Content="Resolved" GroupName="binview" Style="{StaticResource NavButton}" Checked="BinView_Checked"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid x:Name="SearchRow" Margin="0,0,0,8" Visibility="Collapsed">
                            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                            <TextBlock x:Name="SearchHint" Text="Search tasks, tags and notes" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <!-- Shown when tasks are selected (Ctrl+click or Shift+click) -->
                        <Border x:Name="BulkBar" Background="{DynamicResource NavSelected}" CornerRadius="8" Padding="12,6" Margin="0,0,0,8" Visibility="Collapsed">
                            <DockPanel>
                                <TextBlock x:Name="BulkText" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Finish" Click="BulkFinish_Click" Style="{StaticResource LinkButton}"/>
                                    <Button Content="Today" Click="BulkToday_Click" Style="{StaticResource LinkButton}"/>
                                    <Button Content="Tomorrow" Click="BulkTomorrow_Click" Style="{StaticResource LinkButton}"/>
                                    <Button Content="Project ▾" Click="BulkProject_Click" Style="{StaticResource LinkButton}"/>
                                    <Button Content="Delete" Click="BulkDelete_Click" Style="{StaticResource LinkButton}"/>
                                    <Button Content="Clear" Click="BulkClear_Click" Style="{StaticResource LinkButton}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel x:Name="BinTodoHeader">
                            <Grid x:Name="AddRow" Margin="0,0,0,12" Visibility="Collapsed">
                                <TextBox x:Name="BinNewBox" PreviewKeyDown="BinNewBox_PreviewKeyDown" TextChanged="BinNewBox_TextChanged" LostFocus="BinNewBox_LostFocus" FontSize="{DynamicResource TaskFontSize}"/>
                                <TextBlock x:Name="BinNewHint" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="Add a task, like: Call Sam friday at 3pm #Client @calls !"/>
                            </Grid>
                            <TextBlock x:Name="BinEmptyText" Style="{StaticResource Caption}" Text="No tasks here."/>
                        </StackPanel>
                        <TextBlock x:Name="DoneEmptyText" Style="{StaticResource Caption}" Visibility="Collapsed" Text="Nothing resolved yet. Tasks you finish show up here, by day."/>
                    </StackPanel>
                    <Grid>
                    <ScrollViewer x:Name="BinTodoScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="BinList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Background="{DynamicResource TaskRowBg}" CornerRadius="{DynamicResource TaskRowCorner}" Padding="{DynamicResource TaskRowPadding}" Margin="{DynamicResource TaskRowMargin}" BorderBrush="{DynamicResource TaskRowLine}" BorderThickness="{DynamicResource TaskRowLineThickness}" MouseRightButtonUp="TaskRow_RightClick" PreviewMouseLeftButtonDown="BinRow_MouseDown" PreviewMouseMove="BinRow_MouseMove" AllowDrop="True" Drop="BinRow_Drop">
                                        <DockPanel>
                                            <CheckBox x:Name="Check" DockPanel.Dock="Left" Style="{StaticResource TaskCheck}" VerticalAlignment="Top" Margin="0,2,10,0" Click="ResolveBinTask_Click" ToolTip="Finish this task"/>
                                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}" FontSize="12" Click="DeleteBinTask_Click" ToolTip="Delete task (Delete)" VerticalAlignment="Center"/>
                                            <!-- Add to today / Add to tomorrow: shown while the cursor is over the task -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding DataContext.TodayVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <StackPanel x:Name="DayBtns" Orientation="Horizontal">
                                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/></Style></StackPanel.Style>
                                                    <Button x:Name="AddTodayBtn" Content="Today" Style="{StaticResource LinkButton}" FontSize="12" Padding="6,2" Margin="0" Click="AddToToday_Click" ToolTip="Add to today" VerticalAlignment="Center"/>
                                                    <Button x:Name="AddTomorrowBtn" Content="Tomorrow" Style="{StaticResource LinkButton}" FontSize="12" Padding="6,2" Margin="0,0,4,0" Click="AddToTomorrow_Click" ToolTip="Add to tomorrow" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Background="Transparent" Cursor="Hand" MouseLeftButtonUp="BinTaskText_Click" ToolTip="Click to edit. Double-click to rename. Right-click for more.">
                                                <TextBlock x:Name="Title" local:ScriptureLinks.Text="{Binding Text}" TextWrapping="Wrap" FontSize="{DynamicResource TaskFontSize}"/>
                                                <TextBox x:Name="RenameBox" Text="{Binding Text, UpdateSourceTrigger=Explicit}" Visibility="Collapsed" FontSize="{DynamicResource TaskFontSize}" PreviewKeyDown="RenameBox_PreviewKeyDown" LostFocus="RenameBox_LostFocus"/>
                                                <TextBlock x:Name="Details" Text="{Binding Details}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasDetails}" Value="False">
                                            <Setter TargetName="Details" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter TargetName="Details" Property="Foreground" Value="{DynamicResource PriorityHigh}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                            <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource PriorityHigh}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                                            <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource PriorityLow}"/>
                                        </DataTrigger>
                                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="DayBtns" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSetForToday}" Value="True">
                                            <Setter TargetName="AddTodayBtn" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSetForTomorrow}" Value="True">
                                            <Setter TargetName="AddTomorrowBtn" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource NavSelected}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="RenameBox" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer x:Name="UpcomingScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <ItemsControl x:Name="UpcomingList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding Header}" Style="{StaticResource SubHeading}" Margin="0,0,0,6" AllowDrop="True" Drop="UpcomingHeader_Drop" Background="Transparent" ToolTip="Drop a task here to move it to this day"/>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Background="{DynamicResource TaskRowBg}" CornerRadius="{DynamicResource TaskRowCorner}" Padding="{DynamicResource TaskRowPadding}" Margin="{DynamicResource TaskRowMargin}" BorderBrush="{DynamicResource TaskRowLine}" BorderThickness="{DynamicResource TaskRowLineThickness}" MouseRightButtonUp="TaskRow_RightClick">
                                        <DockPanel>
                                            <CheckBox x:Name="Check" DockPanel.Dock="Left" Style="{StaticResource TaskCheck}" VerticalAlignment="Top" Margin="0,2,10,0" Click="ResolveBinTask_Click" ToolTip="Finish this task"/>
                                            <StackPanel Background="Transparent" Cursor="Hand" MouseLeftButtonUp="BinTaskText_Click" ToolTip="Click to edit. Double-click to rename. Right-click for more.">
                                                <TextBlock x:Name="Title" local:ScriptureLinks.Text="{Binding Text}" TextWrapping="Wrap" FontSize="{DynamicResource TaskFontSize}"/>
                                                <TextBox x:Name="RenameBox" Text="{Binding Text, UpdateSourceTrigger=Explicit}" Visibility="Collapsed" FontSize="{DynamicResource TaskFontSize}" PreviewKeyDown="RenameBox_PreviewKeyDown" LostFocus="RenameBox_LostFocus"/>
                                                <TextBlock x:Name="Details" Text="{Binding Details}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasDetails}" Value="False">
                                            <Setter TargetName="Details" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter TargetName="Details" Property="Foreground" Value="{DynamicResource PriorityHigh}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                            <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource PriorityHigh}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                                            <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource PriorityLow}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource NavSelected}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="RenameBox" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                
                                    
                                    
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid x:Name="BoardGrid" Visibility="Collapsed"/>
                    <ScrollViewer x:Name="DoneScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <ItemsControl x:Name="DoneList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Header}" Style="{StaticResource SubHeading}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Panel2}" CornerRadius="6" Padding="14,8,6,8" Margin="0,0,0,6">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}" FontSize="12" Click="DeleteDoneTask_Click" ToolTip="Delete from the list" VerticalAlignment="Center"/>
                                                            <Button DockPanel.Dock="Right" Content="↺" Style="{StaticResource IconButton}" FontSize="14" Click="ReopenDoneTask_Click" ToolTip="Not done after all: back to your task list" VerticalAlignment="Center"/>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="{DynamicResource TaskFontSize}" TextDecorations="Strikethrough" Foreground="{DynamicResource Muted}"/>
                                                                <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0">
                                                                    <Run Text="{Binding From, Mode=OneWay}"/> <Run Text="{Binding Took, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Sidebar: one calm panel with simple sections -->
            <Border Grid.Column="1" Margin="16,0,0,0" Background="{DynamicResource Panel}" CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                <StackPanel>
                    <!-- Today's numbers, on one line -->
                    <Grid Margin="0,0,0,14" x:Name="TasksStatsRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel><TextBlock x:Name="ResolvedTodayText" FontSize="20" FontFamily="{StaticResource HeadingFont}"/>
                            <TextBlock Text="done today" Style="{StaticResource Caption}" FontSize="11"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock x:Name="ResolvedWeekText" FontSize="20" FontFamily="{StaticResource HeadingFont}"/>
                            <TextBlock Text="this week" Style="{StaticResource Caption}" FontSize="11"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock x:Name="BinCountText" FontSize="20" FontFamily="{StaticResource HeadingFont}"/>
                            <TextBlock Text="to do" Style="{StaticResource Caption}" FontSize="11"/></StackPanel>
                    </Grid>
                    <TextBlock x:Name="ResolvedAllText" Visibility="Collapsed"/>

                    <StackPanel x:Name="TodayPanel" Margin="0,0,0,16">
                        <TextBlock x:Name="TodayCapacityText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                        <Button Content="Fill today's sessions" Style="{StaticResource PrimaryButton}" Click="FillToday_Click" HorizontalAlignment="Stretch" ToolTip="Put today's tasks (picked, due today, overdue) into today's focus sessions, most important first"/>
                        <Button x:Name="ReviewBtn" Content="Review today" Style="{StaticResource LinkButton}" Click="ReviewToday_Click" HorizontalAlignment="Left" Margin="0,4,0,0" ToolTip="Decide where each unfinished task goes"/>
                    </StackPanel>

                    <TextBlock Text="VIEWS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="4,0,0,4"/>
                    <StackPanel x:Name="BinFilters" Margin="0,0,0,4"/>
                    <CheckBox x:Name="SmartOrderCheck" Content="Most important first" IsChecked="True" Margin="4,4,0,16" FontSize="12" Checked="SmartOrder_Changed" Unchecked="SmartOrder_Changed" ToolTip="On: overdue and due today first, then today's picks, then by priority. Off: your own order."/>

                    <StackPanel x:Name="ProjectsCard" Margin="0,0,0,16">
                        <DockPanel Margin="4,0,0,4">
                            <Button DockPanel.Dock="Right" Content="" Style="{StaticResource IconButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Padding="6,2" Click="AddProject_Click" ToolTip="New project"/>
                            <TextBlock Text="PROJECTS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid x:Name="NewProjectRow" Margin="0,0,0,6" Visibility="Collapsed">
                            <TextBox x:Name="NewProjectBox" PreviewKeyDown="NewProjectBox_PreviewKeyDown"/>
                            <TextBlock x:Name="NewProjectHint" Text="Project name, then Enter" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <StackPanel x:Name="ProjectFilters"/>
                        <TextBlock x:Name="NoProjectsHint" Text="No projects yet. Type #Name when adding a task." Style="{StaticResource Caption}" FontSize="11.5" Margin="4,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel x:Name="TagsSection" Margin="0,0,0,16">
                        <TextBlock Text="TAGS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="4,0,0,4"/>
                        <StackPanel x:Name="TagFilters"/>
                    </StackPanel>

                    <StackPanel x:Name="TemplatesCard">
                        <DockPanel Margin="4,0,0,4">
                            <Button DockPanel.Dock="Right" Content="" Style="{StaticResource IconButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Padding="6,2" Click="NewTemplate_Click" ToolTip="New template"/>
                            <TextBlock Text="TEMPLATES" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl x:Name="TemplateList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}" Padding="6,0" FontSize="11" Click="DeleteTemplate_Click" ToolTip="Delete template"/>
                                            <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource LinkButton}" Click="UseTemplate_Click" ToolTip="Add these tasks to your list"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="11"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Stats ===== -->
        <ScrollViewer x:Name="StatsPanel" Grid.Column="1" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="28,22">
                <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="Stats" Style="{StaticResource Heading}"/>
                    <TextBlock x:Name="StatsSummary" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,20"/>

                    <!-- Points, level, streaks, records, habits and badges -->
                    <StackPanel x:Name="StatsGame">
                        <Border x:Name="LevelCard" CornerRadius="14" Padding="24,20" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="84" Height="84" VerticalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource FocusBrush}"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="LEVEL" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" Opacity="0.85"/>
                                        <TextBlock x:Name="LevelNumber" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="22,0,22,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LevelName" FontSize="26" FontWeight="SemiBold" FontFamily="{StaticResource HeadingFont}"/>
                                    <TextBlock x:Name="LevelPoints" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,2,0,10"/>
                                    <ProgressBar x:Name="LevelBar" Style="{StaticResource Bar}" Height="8" Maximum="1"/>
                                    <TextBlock x:Name="LevelNext" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="StreakBig" FontSize="34" FontWeight="SemiBold" FontFamily="{StaticResource HeadingFont}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="day streak" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="StreakBest" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Highlights" Style="{StaticResource SubHeading}" Margin="0,0,0,8"/>
                        <WrapPanel x:Name="StatsHighlights" Margin="0,0,0,18"/>

                        <TextBlock Text="Badges" Style="{StaticResource SubHeading}" Margin="0,0,0,8"/>
                        <WrapPanel x:Name="StatsBadges" Margin="0,0,0,18"/>

                        <TextBlock Text="Your patterns" Style="{StaticResource SubHeading}" Margin="0,0,0,6"/>
                        <StackPanel x:Name="StatsPatterns" Margin="0,0,0,22"/>
                    </StackPanel>
                    <StackPanel x:Name="StatsCharts">
                        <TextBlock Text="Focus with blocking, last 4 weeks" Style="{StaticResource SubHeading}" Margin="0,0,0,8"/>
                        <Grid x:Name="StatsFocusChart" Height="150" Margin="0,0,0,22"/>
                        <TextBlock Text="Tasks finished, last 4 weeks" Style="{StaticResource SubHeading}" Margin="0,0,0,8"/>
                        <Grid x:Name="StatsTasksChart" Height="150" Margin="0,0,0,22"/>
                        <TextBlock Text="Estimates and reality" Style="{StaticResource SubHeading}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="StatsEstimateText" TextWrapping="Wrap" Margin="0,0,0,22"/>
                    </StackPanel>
                    <StackPanel x:Name="StatsWorkloadSection">
                        <TextBlock Text="Workload, next 7 days" Style="{StaticResource SubHeading}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" Text="Planned work (tasks placed in sessions, picked for that day, or due) against the focus sessions in that day's plan."/>
                        <StackPanel x:Name="StatsWorkload"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ===== Calendar ===== -->
        <Border x:Name="CalendarPanel" Grid.Column="1" Grid.Row="2" Background="{DynamicResource Panel}" CornerRadius="10" Padding="18" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="‹" Click="CalPrev_Click" Padding="12,4" FontSize="16"/>
                        <Button Content="›" Click="CalNext_Click" Padding="12,4" FontSize="16" Margin="6,0,10,0"/>
                        <TextBlock x:Name="CalDateText" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
                        <Button Content="Today" Style="{StaticResource LinkButton}" Margin="10,0,0,0" VerticalAlignment="Center" Click="CalToday_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="CalDayView" Content="Day" GroupName="calview" IsChecked="True" Style="{StaticResource NavButton}" Checked="CalView_Checked"/>
                        <RadioButton x:Name="CalWeekView" Content="Week" GroupName="calview" Style="{StaticResource NavButton}" Checked="CalView_Checked"/>
                        <CheckBox x:Name="CalShowPlanCheck" Content="Show my plan" VerticalAlignment="Center" Margin="12,0,0,0" Checked="WeekShowPlan_Changed" Unchecked="WeekShowPlan_Changed" Visibility="Collapsed" ToolTip="Untick to see only your calendar events, without focus sessions, breaks, lunch or Devotions"/>
                        <Button Content="Plan this day" Click="CalPlanDay_Click" Margin="12,0,0,0" ToolTip="Open this day in the Day plan"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="CalInfoText" Grid.Row="1" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,10"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <local:DayTimeline x:Name="CalDay"/>
                    <!-- Quick editing right in the calendar (changes save automatically) -->
                    <Border x:Name="CalEditor" Grid.Column="1" Width="290" Margin="16,0,0,0" Padding="18" Background="{DynamicResource Panel2}" CornerRadius="10" VerticalAlignment="Top">
                        <Grid>
                            <TextBlock x:Name="CalNoSelection" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Click a block to edit it here. Drag sessions and breaks to move them, or press Delete to remove one. Changes save automatically."/>
                            <StackPanel x:Name="CalEditorFields" Visibility="Collapsed">
                                <TextBlock x:Name="CalEditorKind" Text="{Binding KindLabel}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12">
                                    <Run Text="Starts at"/> <Run Text="{Binding StartLabel, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock x:Name="CalAnchorNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>
                                <TextBlock Text="Title" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <TextBox x:Name="CalTitleBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Length" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
                                <local:NumberBox x:Name="CalEditorMinutes" Value="{Binding Minutes}" Suffix="min" Width="130" HorizontalAlignment="Left" Minimum="1" Maximum="600"/>
                                <WrapPanel x:Name="CalEditorActions" Margin="0,16,0,0">
                                    <Button Content="Duplicate" Click="Duplicate_Click" Margin="0,0,8,8"/>
                                    <Button Content="Delete" Click="Remove_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <Button Content="Tasks and blocked apps..." Style="{StaticResource LinkButton}" Click="CalOpenInPlan_Click" Margin="0,4,0,0"/>
                                <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,12,0,0" Text="Changes save automatically."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <local:WeekTimeline x:Name="CalWeek" Grid.Row="2" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ===== Training (MainWindow.Training.cs builds its contents) ===== -->
        <Grid x:Name="TrainingPanel" Grid.Column="1" Grid.Row="2" Visibility="Collapsed" AllowDrop="True" Drop="TrainingPanel_Drop" Background="Transparent">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TrainingHost" MaxWidth="960" HorizontalAlignment="Left" Margin="8,4,24,32"/>
            </ScrollViewer>
        </Grid>

        <!-- ===== Block lists ===== -->
        <Grid x:Name="ListsPanel" Grid.Column="1" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="16,20,16,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="4,0,4,14">
                        <TextBlock Text="Block lists" Style="{StaticResource Heading}"/>
                        <TextBlock x:Name="ListsCountText" Style="{StaticResource Caption}" Margin="0,2,0,14"/>
                        <Button x:Name="NewListBtn" Content="+  New block list" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Padding="12,8" Click="NewList_Click"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel2}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                        <DockPanel>
                            <Button Content="Manage" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Click="OpenFreedom_Click" ToolTip="Connect Freedom, choose devices, sync"/>
                            <StackPanel>
