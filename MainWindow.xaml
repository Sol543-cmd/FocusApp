                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource Panel2}" CornerRadius="12" Padding="18,16" Margin="0,14,0,0">
