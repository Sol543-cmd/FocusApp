<Window x:Class="FocusApp.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusApp"
        Title="Focus timer" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Opacity="1" Cursor="SizeAll"
        Foreground="{DynamicResource Text}" FontFamily="{StaticResource BodyFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        ToolTip="Drag to move. Double-click to open Focus.">
    <StackPanel>
    <Grid x:Name="Root" Width="300" Height="38" Margin="4" SizeChanged="Root_SizeChanged">
        <!-- Background: solid, for good contrast on any screen -->
        <Rectangle Fill="{DynamicResource Panel}"/>
        <!-- Time-left bar: full at the start of a block, drains as time runs down -->
        <Rectangle x:Name="Fill" Fill="{DynamicResource FocusBrush}" Opacity="0.45" RenderTransformOrigin="0,0.5">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="FillScale" ScaleX="1"/>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Border x:Name="Outline" BorderBrush="{DynamicResource Muted}" BorderThickness="1.5" CornerRadius="19"/>
        <StackPanel Orientation="Horizontal" Margin="8,0,14,0" VerticalAlignment="Center">
            <!-- Focus sessions: the session number as a Roman numeral in a small serif ring. Breaks and idle: a dot. -->
            <Grid Width="28" Margin="0,0,8,0" VerticalAlignment="Center">
                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{DynamicResource FocusBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border x:Name="Badge" MinWidth="24" Height="24" CornerRadius="12" BorderThickness="1.3" BorderBrush="{DynamicResource FocusBrush}"
                        Padding="3,0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="BadgeText" FontSize="12" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,0,0,1"/>
                </Border>
            </Grid>
            <TextBlock x:Name="TimeText" Text="00:00" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource HeadingFont}"
                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
            <TextBlock x:Name="NameText" FontSize="13" Foreground="{DynamicResource Text}" Opacity="1"
                       MaxWidth="132" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
        <!-- The caret: click to drop down your tasks (and again to fold them up) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
        <Button x:Name="CaretBtn" Content="▾" FontSize="14"
                Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                Foreground="{DynamicResource Text}" Click="Caret_Click" ToolTip="Show your tasks">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel2}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button x:Name="CloseBtn" Content="✕" FontSize="10" Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0"
                Cursor="Hand" Foreground="{DynamicResource Text}" Click="Close_Click" ToolTip="Hide the timer (the 🌡 on the dashboard brings it back)">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="11">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel2}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        </StackPanel>
    </Grid>
    <!-- Tasks: shown while the cursor is over the timer, or all the time when pinned -->
    <Border x:Name="TasksPanel" Width="300" Margin="4,0,4,4" Padding="12,8,8,4" CornerRadius="12"
            Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Muted}" BorderThickness="1.5"
            Visibility="Collapsed" Cursor="Arrow">
        <StackPanel>
            <DockPanel Margin="0,0,0,4">
                <Button x:Name="PinBtn" DockPanel.Dock="Right" Content="📌" FontFamily="Segoe UI Emoji" FontSize="11" Padding="6,2"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Pin_Click" ToolTip="Keep the tasks open"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SessionViewBtn" Content="Session" FontSize="12.5" Padding="4,1" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="SessionView_Click" Foreground="{DynamicResource Text}"/>
                    <Button x:Name="TodayViewBtn" Content="Today" FontSize="12.5" Padding="4,1" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="TodayView_Click" Foreground="{DynamicResource Text}" Margin="4,0,0,0"/>
                    <Button x:Name="PersonalViewBtn" Content="Personal" FontSize="12.5" Padding="4,1" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="PersonalView_Click" Foreground="{DynamicResource Text}" Margin="4,0,0,0"/>
                    <Button x:Name="PersonalScopeBtn" Content="▾" FontSize="11" Padding="3,1" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="PersonalScope_Click" Foreground="{DynamicResource Text}" Opacity="0.65"
                            ToolTip="Choose which personal tasks show: Today, This week, All, or one project"/>
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="TasksHeader" FontSize="11" Foreground="{DynamicResource Muted}" Margin="4,0,0,6"/>
            <!-- About six tasks fit; more scroll -->
            <ScrollViewer x:Name="TaskScroll" MaxHeight="170" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <ItemsControl x:Name="TaskList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <CheckBox x:Name="Check" DockPanel.Dock="Left" Style="{StaticResource TaskCheck}" IsChecked="{Binding Done}"
                                          Margin="0,0,8,0" VerticalAlignment="Top" Click="Task_Click">
                                    <CheckBox.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></CheckBox.LayoutTransform>
                                </CheckBox>
                                <TextBlock x:Name="Text" local:ScriptureLinks.Text="{Binding Text}" FontSize="13" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Done}" Value="True">
                                    <Setter TargetName="Text" Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Muted}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                    <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource PriorityHigh}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" FontSize="12" Foreground="{DynamicResource Muted}" Margin="4,0,0,2" Visibility="Collapsed"/>
            <!-- Drag this grip down to make the list taller (up or down to resize) -->
            <Thumb x:Name="ResizeGrip" Height="12" Cursor="SizeNS" Margin="0,4,0,0" DragDelta="ResizeGrip_DragDelta"
                   ToolTip="Drag to make the list taller or shorter">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Border Width="36" Height="4" CornerRadius="2" Background="{DynamicResource Muted}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </StackPanel>
    </Border>
    </StackPanel>
</Window>
