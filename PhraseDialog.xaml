<Window x:Class="FocusApp.PhraseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm break" SizeToContent="Height" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource BodyFont}">
    <Border Margin="16" Padding="22" CornerRadius="10" Background="{DynamicResource Panel}">
        <StackPanel>
            <TextBlock Text="Last step" Style="{StaticResource Heading}"/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,14">
                To unblock your apps, type the phrase below.
            </TextBlock>
            <TextBlock x:Name="PhraseText" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBox x:Name="PhraseBox" TextChanged="PhraseBox_TextChanged"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Never mind" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="OkButton" Content="Start break" Style="{StaticResource PrimaryButton}"
                        Click="Ok_Click" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
