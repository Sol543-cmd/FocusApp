<Window x:Class="FocusApp.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review your day" Width="640" Height="640" MinHeight="400" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource BodyFont}">
    <Border Margin="16" Padding="22" CornerRadius="10" Background="{DynamicResource Panel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Review your day" Style="{StaticResource Heading}"/>
                <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="Nothing left over. Everything planned for today is done or has a home."/>
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Button Content="Later" Click="Later_Click" ToolTip="Close without changing anything"/>
                <Button Content="Done" Style="{StaticResource PrimaryButton}" Padding="22,8" HorizontalAlignment="Right" Click="Apply_Click"/>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Rows"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
