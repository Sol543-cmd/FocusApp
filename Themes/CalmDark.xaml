<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Calm, dark: teal, sage and dusty blue on deep slate. -->
    <SolidColorBrush x:Key="Sidebar" Color="#1A2023"/>
    <SolidColorBrush x:Key="Bg" Color="#1E2528"/>
    <SolidColorBrush x:Key="Panel" Color="#252D31"/>
    <SolidColorBrush x:Key="Panel2" Color="#2C3539"/>
    <SolidColorBrush x:Key="Panel3" Color="#364146"/>
    <SolidColorBrush x:Key="Line" Color="#323C40"/>
    <SolidColorBrush x:Key="Text" Color="#E4EAE7"/>
    <SolidColorBrush x:Key="Muted" Color="#97A3A0"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#6FB2AA"/>
    <SolidColorBrush x:Key="BreakBrush" Color="#8EBE9B"/>
    <SolidColorBrush x:Key="MeetingBrush" Color="#86A6CF"/>
    <SolidColorBrush x:Key="FocusTint" Color="#24393A"/>
    <SolidColorBrush x:Key="BreakTint" Color="#263529"/>
    <SolidColorBrush x:Key="MeetingTint" Color="#263240"/>
    <SolidColorBrush x:Key="NavSelected" Color="#2A3F40"/>
    <SolidColorBrush x:Key="PriorityHigh" Color="#E08C7C"/>
    <SolidColorBrush x:Key="PriorityNormal" Color="#86918E"/>
    <SolidColorBrush x:Key="PriorityLow" Color="#4C575B"/>
