<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Calm, light: teal, sage and dusty blue on a soft warm white. -->
    <SolidColorBrush x:Key="Sidebar" Color="#EEF1EC"/>
    <SolidColorBrush x:Key="Bg" Color="#F6F5F1"/>
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Panel2" Color="#F0F2EE"/>
    <SolidColorBrush x:Key="Panel3" Color="#E2E7E1"/>
    <SolidColorBrush x:Key="Line" Color="#E3E6E0"/>
    <SolidColorBrush x:Key="Text" Color="#26302C"/>
    <SolidColorBrush x:Key="Muted" Color="#727C77"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#3F7F7A"/>
    <SolidColorBrush x:Key="BreakBrush" Color="#7FA88A"/>
    <SolidColorBrush x:Key="MeetingBrush" Color="#6B8CB5"/>
    <SolidColorBrush x:Key="FocusTint" Color="#E2EEEC"/>
    <SolidColorBrush x:Key="BreakTint" Color="#E9F1EA"/>
    <SolidColorBrush x:Key="MeetingTint" Color="#E7EDF5"/>
    <SolidColorBrush x:Key="NavSelected" Color="#DDEBE8"/>
    <SolidColorBrush x:Key="PriorityHigh" Color="#D0705F"/>
    <SolidColorBrush x:Key="PriorityNormal" Color="#9AA39E"/>
    <SolidColorBrush x:Key="PriorityLow" Color="#D3D8D4"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OverlayBg" Color="#F7FFFFFF"/>
    <SolidColorBrush x:Key="Shade" Color="#A6F6F5F1"/>
</ResourceDictionary>
