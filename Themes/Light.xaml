<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light: clean white pages on a warm off-white, one warm red accent. -->
    <SolidColorBrush x:Key="Sidebar" Color="#F6F4F1"/>
    <SolidColorBrush x:Key="Bg" Color="#FAF9F7"/>
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Panel2" Color="#F4F2EF"/>
    <SolidColorBrush x:Key="Panel3" Color="#EBE8E4"/>
    <SolidColorBrush x:Key="Line" Color="#ECEAE6"/>
    <SolidColorBrush x:Key="Text" Color="#202020"/>
    <SolidColorBrush x:Key="Muted" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#DC4C3E"/>
    <SolidColorBrush x:Key="BreakBrush" Color="#058527"/>
    <SolidColorBrush x:Key="MeetingBrush" Color="#246FE0"/>
    <SolidColorBrush x:Key="FocusTint" Color="#FCEDEB"/>
    <SolidColorBrush x:Key="BreakTint" Color="#E5F3E9"/>
    <SolidColorBrush x:Key="MeetingTint" Color="#E8F0FC"/>
    <SolidColorBrush x:Key="NavSelected" Color="#FFEDE8"/>
    <SolidColorBrush x:Key="PriorityHigh" Color="#D1453B"/>
    <SolidColorBrush x:Key="PriorityNormal" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="PriorityLow" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OverlayBg" Color="#F7FFFFFF"/>
    <SolidColorBrush x:Key="Shade" Color="#A6FAF9F7"/>
</ResourceDictionary>
