<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Monochrome, dark: white, black and grays only. -->
    <SolidColorBrush x:Key="Sidebar" Color="#111111"/>
    <SolidColorBrush x:Key="Bg" Color="#161616"/>
    <SolidColorBrush x:Key="Panel" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="Panel2" Color="#282828"/>
    <SolidColorBrush x:Key="Panel3" Color="#333333"/>
    <SolidColorBrush x:Key="Line" Color="#303030"/>
    <SolidColorBrush x:Key="Text" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Muted" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="BreakBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="MeetingBrush" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="FocusTint" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="BreakTint" Color="#262626"/>
    <SolidColorBrush x:Key="MeetingTint" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="NavSelected" Color="#333333"/>
    <SolidColorBrush x:Key="PriorityHigh" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PriorityNormal" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="PriorityLow" Color="#4D4D4D"/>
    <SolidColorBrush x:Key="OnAccent" Color="#111111"/>
    <SolidColorBrush x:Key="OverlayBg" Color="#F71F1F1F"/>
    <SolidColorBrush x:Key="Shade" Color="#B3161616"/>
</ResourceDictionary>
