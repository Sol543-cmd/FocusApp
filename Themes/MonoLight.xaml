<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Monochrome, light: black, white and grays only. -->
    <SolidColorBrush x:Key="Sidebar" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Bg" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Panel2" Color="#F1F1F1"/>
    <SolidColorBrush x:Key="Panel3" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="Line" Color="#E2E2E2"/>
    <SolidColorBrush x:Key="Text" Color="#111111"/>
    <SolidColorBrush x:Key="Muted" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BreakBrush" Color="#8C8C8C"/>
    <SolidColorBrush x:Key="MeetingBrush" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="FocusTint" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="BreakTint" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="MeetingTint" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavSelected" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="PriorityHigh" Color="#000000"/>
    <SolidColorBrush x:Key="PriorityNormal" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="PriorityLow" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OverlayBg" Color="#F7FFFFFF"/>
    <SolidColorBrush x:Key="Shade" Color="#A6FAFAFA"/>
</ResourceDictionary>
