<Window x:Class="FocusApp.VocabManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Greek words" Width="760" Height="720" MinWidth="560" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource BodyFont}">
    <Border Margin="16" Padding="24,20" CornerRadius="12" Background="{DynamicResource Panel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="FindTab" Content="Find words" GroupName="vtab" IsChecked="True" Style="{StaticResource NavButton}" Checked="Tab_Checked"/>
                        <RadioButton x:Name="MineTab" Content="My words" GroupName="vtab" Style="{StaticResource NavButton}" Checked="Tab_Checked"/>
                    </StackPanel>
                    <TextBlock Text="Greek words" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Margin="0,0,0,6">
                    <TextBox x:Name="SearchBox" FontSize="15" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                    <TextBlock x:Name="SearchHint" Text="Type Greek (accents optional) or English, then Enter to add the top match" Style="{StaticResource Caption}"
                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <TextBlock x:Name="CountText" Style="{StaticResource Caption}" FontSize="12" Margin="2,0,0,10"/>
                <!-- Shown when words are ticked: act on them all at once -->
                <Border x:Name="BulkBar" Background="{DynamicResource NavSelected}" CornerRadius="8" Padding="12,6" Margin="0,0,0,10" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BulkAddBtn" Content="Add all" Style="{StaticResource PrimaryButton}" Click="BulkAdd_Click" Margin="0,0,6,0" Padding="14,5"/>
                            <Button x:Name="BulkRemoveBtn" Content="Remove all" Click="BulkRemove_Click" Margin="0,0,6,0" Padding="14,5"/>
                            <Button Content="Clear" Style="{StaticResource LinkButton}" Click="BulkClear_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="BulkText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </DockPanel>
                </Border>
            </StackPanel>
            <!-- Add your own word / edit a word -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel2}" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="EditTitle" Text="Add your own word" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="GreekBox" FontSize="15"/>
                            <TextBlock x:Name="GreekHint" Text="Greek" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <Grid Grid.Column="2">
                            <TextBox x:Name="EnglishBox" FontSize="15"/>
                            <TextBlock x:Name="EnglishHint" Text="Meaning" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button x:Name="CancelEditBtn" Content="Cancel" Click="CancelEdit_Click" Margin="0,0,6,0" Visibility="Collapsed"/>
                            <Button x:Name="SaveWordBtn" Content="Add" Style="{StaticResource PrimaryButton}" Click="SaveWord_Click" Padding="18,7"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="EditNote" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Your own words and edited words join your review bank straight away."/>
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Results"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
