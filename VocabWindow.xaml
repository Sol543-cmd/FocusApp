<Window x:Class="FocusApp.VocabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Greek practice" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Width="400" Height="300"
        Foreground="{DynamicResource Text}" FontFamily="{StaticResource BodyFont}">
    <Window.Resources>
        <!-- Flat tiles: their colors come only from Focus (no Windows hover effects hiding the highlight) -->
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Rectangle Fill="{DynamicResource Shade}"/>

        <!-- The practice card -->
        <Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center" Width="760"
                Background="{DynamicResource Panel}" CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource Line}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.22" Color="#000000"/>
            </Border.Effect>
            <StackPanel Margin="40,30,40,28">
                <DockPanel Margin="0,0,0,18">
                    <Button x:Name="LaterButton" DockPanel.Dock="Right" Content="Later" Style="{StaticResource LinkButton}" Click="Later_Click"
                            ToolTip="Skip this round (it comes back in 20 minutes)" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="logo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="FOCUS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="TitleText" Text="Greek practice" FontSize="28" FontWeight="SemiBold" FontFamily="{StaticResource HeadingFont}"/>
                <TextBlock x:Name="HintText" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,4,0,20" TextWrapping="Wrap"
                           Text="Click a Greek word, then its meaning. Click a matched pair again to undo it."/>
                <ScrollViewer x:Name="TilesScroll" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="GreekColumn"/>
                        <StackPanel x:Name="EnglishColumn" Grid.Column="2"/>
                    </Grid>
                </ScrollViewer>
                <!-- Reviewing any time: keep going, with a choice of round size -->
                <DockPanel x:Name="ContinuePanel" Margin="0,22,0,0" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Done" Click="Done_Click" Margin="0,0,8,0" Padding="20,10"/>
                        <Button x:Name="NextButton" Content="Next round" Style="{StaticResource PrimaryButton}" Padding="26,10" FontSize="15" Click="Next_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Words per round" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel x:Name="SizeChoices" Orientation="Horizontal"/>
                    </StackPanel>
                </DockPanel>
                <DockPanel x:Name="GoRow" Margin="0,22,0,0">
                    <Button x:Name="GoButton" DockPanel.Dock="Right" Content="Go" Style="{StaticResource PrimaryButton}" Padding="34,10"
                            FontSize="15" Click="Go_Click" IsEnabled="False"/>
                    <TextBlock x:Name="ResultText" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock x:Name="SessionText" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
